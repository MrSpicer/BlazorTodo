@using TodoList.Models
@using TodoList.Models.Enums
@using TodoList.Services.Access
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject IProjectMembershipService Membership
@inject RoleManager<IdentityRole<Guid>> RoleManager
@inject NavigationManager Navigation

<Modal IsVisible="IsVisible" OnClose="Close" Title="@(IsEditing ? "Edit Project" : "New Project")" Size="compact">
	<HeaderIcon>
		@if (IsEditing)
		{
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
				<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
			</svg>
		}
		else
		{
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
			</svg>
		}
	</HeaderIcon>
	<ChildContent>
		<EditForm Model="@_project" OnValidSubmit="HandleValidSubmit">
			<DataAnnotationsValidator />
			<div class="modal-body">
				<div class="form-group">
					<label for="projectName" class="form-label">Project Name</label>
					<InputText id="projectName" class="form-input" @bind-Value="_project.Name"
					           placeholder="e.g., Work, Personal, Side Project..." />
					<ValidationMessage For="@(() => _project.Name)" class="validation-error" />
				</div>

				<div class="form-group">
					<label for="projectDescription" class="form-label">Description <span class="optional">(optional)</span></label>
					<InputTextArea id="projectDescription" class="form-input form-textarea" rows="2"
					               @bind-Value="_project.Description"
					               placeholder="What is this project about?" />
				</div>

				<div class="form-group">
					<label class="form-label">Project Color</label>
					<div class="color-picker">
						@foreach (var color in _presetColors)
						{
							<button type="button"
							        class="color-option @(_project.Color == color ? "selected" : "")"
							        style="background-color: @color;"
							        @onclick="() => _project.Color = color"
							        title="Select color">
								@if (_project.Color == color)
								{
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
										<path d="M5 12l5 5L20 7"/>
									</svg>
								}
							</button>
						}
					</div>
				</div>

					@if (IsEditing && _canManageAccess)
					{
						<div class="form-group members-section">
							<label class="form-label">Members</label>
							<div class="member-list">
								@foreach (var m in _members)
								{
									<div class="member-row">
										<span class="member-name">@(string.IsNullOrWhiteSpace(m.DisplayName) ? m.Email : m.DisplayName)</span>
										<span class="member-role">@(m.IsOwner ? "Owner" : m.RoleName)</span>
										@if (!m.IsOwner)
										{
											<span class="member-status @(m.Status == ProjectMemberStatus.Accepted ? "accepted" : "pending")">@m.Status</span>
										}
									</div>
								}
							</div>
							<div class="invite-row">
								<input type="email" class="form-input" placeholder="Invite by email…"
								       @bind="_inviteEmail" @bind:event="oninput" />
								<select class="form-input invite-role" @bind="_inviteRoleId">
									@foreach (var r in _roles)
									{
										<option value="@r.Id">@r.Name</option>
									}
								</select>
								<button type="button" class="btn btn-primary invite-btn"
								        disabled="@(_inviting || _roles.Count == 0)" @onclick="HandleInviteAsync">Invite</button>
							</div>
							@if (!string.IsNullOrEmpty(_inviteMessage))
							{
								<p class="invite-ok">@_inviteMessage</p>
							}
							@if (!string.IsNullOrEmpty(_inviteError))
							{
								<p class="validation-error">@_inviteError</p>
							}
						</div>
					}
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-ghost" @onclick="Close">Cancel</button>
				<button type="submit" class="btn btn-primary">
					@if (IsEditing)
					{
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
						</svg>
						<span>Save Changes</span>
					}
					else
					{
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 5v14M5 12h14"/>
						</svg>
						<span>Create Project</span>
					}
				</button>
			</div>
		</EditForm>
	</ChildContent>
</Modal>

<style>
	.form-group {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.form-label {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.optional {
		font-weight: 400;
		color: var(--text-secondary);
	}

	.form-input {
		padding: var(--space-3) var(--space-4);
		border: 1.5px solid var(--border);
		border-radius: var(--radius-lg);
		font-size: 0.9375rem;
		transition: all var(--transition-fast);
		background: var(--surface);
		width: 100%;
	}

	.form-input:focus {
		outline: none;
		border-color: var(--primary);
		box-shadow: 0 0 0 3px var(--primary-light);
	}

	.form-input::placeholder {
		color: var(--text-muted);
	}

	.form-textarea {
		resize: vertical;
		min-height: 60px;
	}

	.validation-error {
		font-size: 0.8125rem;
		color: var(--danger);
	}

	.color-picker {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.color-option {
		width: 36px;
		height: 36px;
		border-radius: var(--radius-lg);
		border: 3px solid transparent;
		cursor: pointer;
		transition: all var(--transition-fast);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.color-option:hover {
		transform: scale(1.1);
		box-shadow: var(--shadow-md);
	}

	.color-option.selected {
		border-color: var(--text-primary);
		transform: scale(1.05);
	}

	.modal-body {
		gap: var(--space-5);
	}

	.members-section {
		border-top: 1px solid var(--border-light);
		padding-top: var(--space-4);
	}

	.member-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.member-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.875rem;
	}

	.member-name {
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.member-role {
		color: var(--text-secondary);
		font-size: 0.8125rem;
	}

	.member-status {
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		padding: 0.0625rem 0.375rem;
		border-radius: var(--radius-full);
	}

	.member-status.accepted {
		background: var(--success-light, #d1fae5);
		color: var(--success, #059669);
	}

	.member-status.pending {
		background: var(--gray-200);
		color: var(--text-secondary);
	}

	.invite-row {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.invite-row .form-input {
		flex: 1;
		min-width: 140px;
	}

	.invite-row .invite-role {
		flex: 0 0 auto;
		min-width: 120px;
		width: auto;
	}

	.invite-ok {
		font-size: 0.8125rem;
		color: var(--success, #059669);
	}
</style>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public bool IsEditing { get; set; }

	[Parameter]
	public Project? EditingProject { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public EventCallback<Project> OnSave { get; set; }

	[CascadingParameter]
	private Task<AuthenticationState>? AuthState { get; set; }

	private Project _project = new();

	// Membership / invite state (edit mode, authenticated users who can manage access).
	private bool _canManageAccess;
	private Guid _currentUserId;
	private IReadOnlyList<ProjectMemberView> _members = Array.Empty<ProjectMemberView>();
	private List<IdentityRole<Guid>> _roles = new();
	private Guid? _membershipLoadedFor;
	private string _inviteEmail = string.Empty;
	private Guid _inviteRoleId;
	private bool _inviting;
	private string? _inviteMessage;
	private string? _inviteError;

	private readonly string[] _presetColors = new[]
	{
		"#6366f1",
		"#3b82f6",
		"#10b981",
		"#f59e0b",
		"#ef4444",
		"#8b5cf6",
		"#ec4899",
		"#14b8a6",
		"#64748b"
	};

	protected override void OnParametersSet()
	{
		if (IsVisible)
		{
			if (IsEditing && EditingProject != null)
			{
				_project = new Project
				{
					Id = EditingProject.Id,
					Name = EditingProject.Name,
					Description = EditingProject.Description,
					Color = EditingProject.Color,
					CreatedAt = EditingProject.CreatedAt,
					IsDefault = EditingProject.IsDefault
				};
			}
			else
			{
				_project = new Project
				{
					Color = _presetColors[Random.Shared.Next(_presetColors.Length)]
				};
			}
		}
	}

	// Load membership context once per opened project. Runs after OnParametersSet so _project is
	// already cloned. Only touches the DB for authenticated edit sessions.
	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && IsEditing && EditingProject is not null)
		{
			if (_membershipLoadedFor != EditingProject.Id)
			{
				_membershipLoadedFor = EditingProject.Id;
				await LoadMembershipAsync(EditingProject.Id);
			}
		}
		else if (!IsVisible)
		{
			ResetMembershipState();
		}
	}

	private async Task LoadMembershipAsync(Guid projectId)
	{
		ResetMembershipState();
		_currentUserId = await GetCurrentUserIdAsync();
		if (_currentUserId == Guid.Empty)
			return;

		_canManageAccess = await Membership.CanManageAccessAsync(projectId, _currentUserId);
		if (!_canManageAccess)
			return;

		_roles = RoleManager.Roles.OrderBy(r => r.Name).ToList();
		if (_inviteRoleId == Guid.Empty && _roles.Count > 0)
			_inviteRoleId = _roles[0].Id;
		_members = await Membership.GetMembersAsync(projectId);
	}

	private void ResetMembershipState()
	{
		_canManageAccess = false;
		_members = Array.Empty<ProjectMemberView>();
		_inviteEmail = string.Empty;
		_inviteMessage = null;
		_inviteError = null;
		_membershipLoadedFor = IsVisible ? _membershipLoadedFor : null;
	}

	private async Task HandleInviteAsync()
	{
		_inviteMessage = null;
		_inviteError = null;
		if (EditingProject is null)
			return;

		_inviting = true;
		try
		{
			var result = await Membership.InviteAsync(
				EditingProject.Id, _currentUserId, _inviteEmail, _inviteRoleId, Navigation.BaseUri);
			if (result.Succeeded)
			{
				_inviteMessage = result.Message;
				_inviteEmail = string.Empty;
				_members = await Membership.GetMembersAsync(EditingProject.Id);
			}
			else
			{
				_inviteError = result.Message;
			}
		}
		finally
		{
			_inviting = false;
		}
	}

	private async Task<Guid> GetCurrentUserIdAsync()
	{
		if (AuthState is null)
			return Guid.Empty;
		var state = await AuthState;
		var sub = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		return Guid.TryParse(sub, out var id) ? id : Guid.Empty;
	}

	private async Task HandleValidSubmit()
	{
		await OnSave.InvokeAsync(_project);
		await Close();
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}
}
