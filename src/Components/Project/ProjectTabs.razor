@using TodoList.Models
@using TodoList.Models.Enums

<div class="project-tabs-wrapper">
    <div class="project-tabs-container">
        <div class="project-tabs">
            @foreach (var project in Projects)
            {
                <button class="project-tab @(IsSelected(project) ? "active" : "")"
                        @onclick="() => OnProjectSelected.InvokeAsync(project)">
                    <span class="tab-color" style="background-color: @project.Color;"></span>
                    <span class="tab-name">@project.Name</span>
                    <span class="tab-count">@GetTodoCount(project.Id)</span>
                    @if (CanModify(project.Id))
                    {
                        <button class="tab-edit"
                                @onclick:stopPropagation="true"
                                @onclick="() => OnEditProject.InvokeAsync(project)"
                                aria-label="Edit project">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                    }
                    @if (CanRemove(project.Id))
                    {
                        <button class="tab-close"
                                @onclick:stopPropagation="true"
                                @onclick="() => OnDeleteProject.InvokeAsync(project)"
                                aria-label="Delete project">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 6L6 18M6 6l12 12"/>
                            </svg>
                        </button>
                    }
                </button>
            }
        </div>
        <button class="new-project-btn"
                @onclick="() => OnNewProjectClick.InvokeAsync()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            <span>New Project</span>
        </button>
    </div>
</div>

<style>
    .project-tabs-wrapper {
        margin-bottom: var(--space-6);
    }
    
    .project-tabs-container {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding-bottom: var(--space-3);
        border-bottom: 2px solid var(--border-light);
    }
    
    .project-tabs {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        flex: 1;
    }
    
    .project-tab {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-lg);
        cursor: pointer;
        transition: all var(--transition-fast);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
    }
    
    .project-tab:hover {
        border-color: var(--gray-300);
        background: var(--surface-hover);
        color: var(--text-primary);
    }
    
    .project-tab.active {
        background: var(--primary-50);
        border-color: var(--primary);
        color: #4338ca;
        box-shadow: var(--shadow-sm);
    }
    
    .tab-color {
        width: 10px;
        height: 10px;
        border-radius: var(--radius-full);
        flex-shrink: 0;
    }
    
    .tab-name {
        max-width: 120px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .tab-count {
        background: var(--gray-200);
        color: var(--text-secondary);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.125rem 0.5rem;
        border-radius: var(--radius-full);
        min-width: 20px;
        text-align: center;
    }
    
    .project-tab.active .tab-count {
        background: var(--primary);
        color: var(--text-inverse);
    }
    
    .tab-edit,
    .tab-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border: none;
        background: transparent;
        border-radius: var(--radius-sm);
        color: var(--text-muted);
        cursor: pointer;
        opacity: 0;
        transition: all var(--transition-fast);
        margin-left: var(--space-1);
    }

    .project-tab:hover .tab-edit,
    .project-tab:hover .tab-close {
        opacity: 1;
    }

    .tab-edit:hover {
        background: var(--primary-50);
        color: var(--primary);
    }

    .tab-close:hover {
        background: var(--danger-light);
        color: var(--danger);
    }
    
    .new-project-btn {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        background: transparent;
        border: 1.5px dashed var(--border);
        border-radius: var(--radius-lg);
        color: #475569;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition-fast);
        white-space: nowrap;
    }
    
    .new-project-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-50);
    }
    
    @@media (max-width: 640px) {
        .project-tabs-container {
            flex-direction: column;
            align-items: stretch;
        }
        
        .project-tabs {
            overflow-x: auto;
            flex-wrap: nowrap;
            padding-bottom: var(--space-2);
        }
        
        .new-project-btn {
            align-self: flex-start;
        }

        .tab-edit,
        .tab-close {
            opacity: 1;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Project> Projects { get; set; } = new List<Project>();

    [Parameter]
    public Project? SelectedProject { get; set; }

    [Parameter]
    public IReadOnlyList<TodoItem> Todos { get; set; } = new List<TodoItem>();

    [Parameter]
    public EventCallback<Project> OnProjectSelected { get; set; }

    [Parameter]
    public EventCallback OnNewProjectClick { get; set; }

    [Parameter]
    public EventCallback<Project> OnEditProject { get; set; }

    [Parameter]
    public EventCallback<Project> OnDeleteProject { get; set; }

    /// <summary>The acting user's effective permissions per project. Absent entries (anonymous/local
    /// or a freshly created project) default to full control so the owner's own controls show.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, ProjectPermission>? PermissionsByProject { get; set; }

    private ProjectPermission PermsFor(Guid projectId) =>
        PermissionsByProject is not null && PermissionsByProject.TryGetValue(projectId, out var p)
            ? p
            : ProjectPermission.All;

    private bool CanModify(Guid projectId) => PermsFor(projectId).HasFlag(ProjectPermission.ProjectModify);
    private bool CanRemove(Guid projectId) => PermsFor(projectId).HasFlag(ProjectPermission.ProjectRemove);

    private bool IsSelected(Project project)
    {
        return SelectedProject?.Id == project.Id;
    }

    private int GetTodoCount(Guid projectId)
    {
        return Todos.Count(t => t.ParentId is null && !BuiltInStatusIds.IsCompletedLike(t.StatusId) && t.ProjectId == projectId);
    }
}
