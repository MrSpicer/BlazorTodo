@*
	Shared modal shell. Owns overlay, container, header, close button, and (optionally) the pinned
	body/footer structure. Two ways to supply content:
	  1. Structured (preferred): provide `BodyContent` (the only scrolling region) and `FooterContent`
	     (pinned action bar). The shell wraps them in `.modal-body` / `.modal-footer` so the footer
	     is always visible.
	  2. Free-form (`ChildContent`): for form modals whose <form> must wrap both the scroll region and
	     the pinned footer, render a `<form class="modal-form">` containing your own `.modal-body` and
	     `.modal-footer` siblings.
*@
@if (IsVisible)
{
	<div class="modal-overlay app-modal-overlay" @onclick="HandleOverlayClick">
		<div class="modal-container app-modal @SizeClass"
		     role="dialog"
		     aria-modal="true"
		     aria-labelledby="@_titleId"
		     @onclick:stopPropagation="true">
			<div class="modal-header">
				<h2 class="modal-title" id="@_titleId">
					@HeaderIcon
					<span>@Title</span>
				</h2>
				<button class="modal-close" @onclick="HandleClose" aria-label="Close">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 6L6 18M6 6l12 12"/>
					</svg>
				</button>
			</div>
			@if (BodyContent is not null)
			{
				<div class="modal-body">
					@BodyContent
				</div>
			}
			@if (FooterContent is not null)
			{
				<div class="modal-footer">
					@FooterContent
				</div>
			}
			@ChildContent
		</div>
	</div>
}

@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
	[Parameter] public RenderFragment? HeaderIcon { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	/// <summary>Scrolling body region; wrapped in `.modal-body` by the shell.</summary>
	[Parameter] public RenderFragment? BodyContent { get; set; }
	/// <summary>Pinned action bar; wrapped in `.modal-footer` by the shell. Always visible.</summary>
	[Parameter] public RenderFragment? FooterContent { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }

	/// <summary>"compact" (440px), "medium" (600px), "wide" (760px), "large" (90vw), or "default" (75vw).
	/// All sizes are content-height (capped) on desktop and full-screen on phones.</summary>
	[Parameter] public string Size { get; set; } = "default";

	[Parameter] public bool CloseOnOverlayClick { get; set; } = true;

	private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

	private string SizeClass => Size switch
	{
		"compact" => "modal-compact",
		"medium" => "modal-medium",
		"wide" => "modal-wide",
		"large" => "modal-large",
		_ => string.Empty
	};

	private Task HandleClose() => OnClose.InvokeAsync();
	private Task HandleOverlayClick() => CloseOnOverlayClick ? OnClose.InvokeAsync() : Task.CompletedTask;
}
