@using TodoList.Helpers
@using TodoList.Models
@implements IDisposable
@inject IStatusService StatusService

@{
	var status = StatusService.GetById(StatusId);
	var (bg, fg) = StatusColor.Resolve(status?.Color);
}
<span class="status-badge" style="background-color:@bg;color:@fg">@(status?.Name ?? "Unknown")</span>

@code {
	[Parameter, EditorRequired]
	public Guid StatusId { get; set; }

	protected override void OnInitialized()
	{
		StatusService.OnStatusesChanged += StateHasChanged;
	}

	public void Dispose()
	{
		StatusService.OnStatusesChanged -= StateHasChanged;
	}
}
