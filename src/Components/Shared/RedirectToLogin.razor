@inject NavigationManager Navigation

@code {
	// Sends anonymous visitors of an [Authorize]-gated route to the Identity login page,
	// preserving where they were headed so they return after signing in.
	protected override void OnInitialized()
	{
		var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
		Navigation.NavigateTo(
			$"/Identity/Account/Login?returnUrl={Uri.EscapeDataString("/" + returnUrl)}",
			forceLoad: true);
	}
}
