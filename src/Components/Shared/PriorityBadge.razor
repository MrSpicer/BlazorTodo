@using TodoList.Models
@using TodoList.Helpers
@using TodoList.Services
@inject IPriorityService PriorityService

@{
	var p = PriorityService.GetById(PriorityId);
	var name = p?.Name ?? "—";
	var (bg, fg) = StatusColor.Resolve(p?.Color);
}
<span class="priority-badge" style="background-color:@bg;color:@fg">@name</span>

@code {
	[Parameter, EditorRequired]
	public Guid PriorityId { get; set; }
}
