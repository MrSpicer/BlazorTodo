@using System.ComponentModel.DataAnnotations
@using TodoList.Models
@implements IDisposable
@inject ITagService TagService
@inject IDialogService DialogService

<Modal IsVisible="IsVisible" OnClose="Close" Title="Tags" Size="medium">
	<HeaderIcon>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
			<line x1="7" y1="7" x2="7.01" y2="7"/>
		</svg>
	</HeaderIcon>
	<BodyContent>
		<div class="tag-content">
			<EditForm Model="@_createForm" OnValidSubmit="HandleCreate">
					<DataAnnotationsValidator />
					<div class="tag-create-row">
						<InputText class="form-input tag-create-input"
						           @bind-Value="_createForm.Name"
						           placeholder="New tag name..."
						           data-testid="tag-create-input" />
						<button type="submit" class="btn btn-primary" data-testid="tag-create-submit">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M12 5v14M5 12h14"/>
							</svg>
							<span>Add</span>
						</button>
					</div>
					<ValidationMessage For="@(() => _createForm.Name)" class="validation-error" />
				</EditForm>

				@if (!string.IsNullOrEmpty(_bannerMessage))
				{
					<div class="tag-banner @(_bannerIsError ? "tag-banner-error" : "tag-banner-info")" data-testid="tag-banner">
						<span>@_bannerMessage</span>
						<button type="button" class="tag-banner-dismiss" @onclick="() => _bannerMessage = null" aria-label="Dismiss">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M18 6L6 18M6 6l12 12"/>
							</svg>
						</button>
					</div>
				}

				<div class="tag-toolbar">
					<label for="tagSort" class="tag-toolbar-label">Sort by</label>
					<select id="tagSort" class="form-input tag-sort-select" @bind="_sortMode" data-testid="tag-sort">
						<option value="@SortMode.NameAsc">Name (A–Z)</option>
						<option value="@SortMode.NameDesc">Name (Z–A)</option>
						<option value="@SortMode.UsageDesc">Most used</option>
					</select>
					<span class="tag-toolbar-count">@TagService.Tags.Count tag@(TagService.Tags.Count == 1 ? "" : "s")</span>
				</div>

				@if (TagService.Tags.Count == 0)
				{
					<div class="tag-empty" data-testid="tag-empty">
						<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
							<line x1="7" y1="7" x2="7.01" y2="7"/>
						</svg>
						<p>No tags yet — add one above.</p>
					</div>
				}
				else
				{
					<ul class="tag-list" data-testid="tag-list">
						@foreach (var tag in SortedTags)
						{
							var count = _usageCounts.TryGetValue(tag.Id, out var c) ? c : 0;
							<li class="tag-row" @key="tag.Id" data-testid="tag-row">
								@if (_renamingId == tag.Id)
								{
									<input type="text"
									       class="form-input tag-rename-input"
									       value="@_renameBuffer"
									       @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
									       @onkeydown="e => OnRenameKeyDown(e, tag)"
									       @ref="_renameInputRef"
									       data-testid="tag-rename-input" />
									<span class="tag-count">@count used</span>
									<div class="tag-actions">
										<button class="tag-action-btn primary"
										        @onclick="() => SaveRename(tag)"
										        title="Save"
										        aria-label="Save rename"
										        data-testid="tag-rename-save">
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
												<path d="M5 12l5 5L20 7"/>
											</svg>
										</button>
										<button class="tag-action-btn"
										        @onclick="CancelRename"
										        title="Cancel"
										        aria-label="Cancel rename"
										        data-testid="tag-rename-cancel">
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
												<path d="M18 6L6 18M6 6l12 12"/>
											</svg>
										</button>
									</div>
								}
								else
								{
									<span class="tag-name">@tag.Name</span>
									<span class="tag-count">@count used</span>
									<div class="tag-actions">
										<button class="tag-action-btn"
										        @onclick="() => StartRename(tag)"
										        title="Rename tag"
										        aria-label="Rename tag @tag.Name"
										        data-testid="tag-edit-btn">
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
												<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
											</svg>
										</button>
										<button class="tag-action-btn danger"
										        @onclick="() => HandleDelete(tag)"
										        title="Delete tag"
										        aria-label="Delete tag @tag.Name"
										        data-testid="tag-delete-btn">
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
											</svg>
										</button>
									</div>
								}
							</li>
						}
					</ul>
				}
		</div>
	</BodyContent>
	<FooterContent>
		<button type="button" class="btn btn-ghost" @onclick="Close">Close</button>
	</FooterContent>
</Modal>

<style>
	.tag-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.tag-create-row {
		display: flex;
		gap: var(--space-2);
		align-items: stretch;
	}

	.tag-create-input {
		flex: 1;
	}

	.tag-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-md);
		font-size: 0.8125rem;
	}

	.tag-banner-info {
		background: var(--primary-50);
		color: #4338ca;
		border: 1px solid var(--primary-light);
	}

	.tag-banner-error {
		background: var(--danger-light);
		color: #991b1b;
		border: 1px solid #fca5a5;
	}

	.tag-banner-dismiss {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border: none;
		background: transparent;
		color: inherit;
		border-radius: var(--radius-full);
		cursor: pointer;
		opacity: 0.7;
	}

	.tag-banner-dismiss:hover {
		opacity: 1;
	}

	.tag-toolbar {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.tag-toolbar-label {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.tag-sort-select {
		flex: 0 0 auto;
		padding: var(--space-2) var(--space-3);
		font-size: 0.875rem;
		width: auto;
	}

	.tag-toolbar-count {
		margin-left: auto;
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.tag-empty {
		text-align: center;
		padding: var(--space-6) var(--space-4);
		background: var(--gray-50);
		border: 2px dashed var(--border);
		border-radius: var(--radius-lg);
		color: var(--text-muted);
	}

	.tag-empty svg {
		color: var(--text-muted);
		opacity: 0.6;
		margin-bottom: var(--space-2);
	}

	.tag-empty p {
		margin: 0;
		font-size: 0.875rem;
	}

	.tag-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.tag-row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-md);
		border: 1px solid transparent;
		transition: all var(--transition-fast);
	}

	.tag-row:hover {
		background: var(--gray-50);
		border-color: var(--border-light);
	}

	.tag-row:hover .tag-actions {
		opacity: 1;
	}

	.tag-name {
		flex: 1;
		font-size: 0.9375rem;
		color: var(--text-primary);
		font-weight: 500;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.tag-rename-input {
		flex: 1;
		padding: var(--space-2) var(--space-3);
		font-size: 0.9375rem;
	}

	.tag-count {
		font-size: 0.75rem;
		color: var(--text-muted);
		background: var(--gray-100);
		padding: 0.125rem 0.5rem;
		border-radius: var(--radius-full);
		flex-shrink: 0;
	}

	.tag-actions {
		display: flex;
		gap: var(--space-1);
		opacity: 0;
		transition: opacity var(--transition-fast);
		flex-shrink: 0;
	}

	.tag-action-btn {
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		border-radius: var(--radius-md);
		color: var(--text-muted);
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.tag-action-btn:hover {
		background: var(--gray-100);
		color: var(--text-primary);
	}

	.tag-action-btn.primary {
		color: var(--primary);
	}

	.tag-action-btn.primary:hover {
		background: var(--primary-50);
	}

	.tag-action-btn.danger:hover {
		background: var(--danger-light);
		color: var(--danger);
	}

	@@media (max-width: 640px) {
		.tag-actions {
			opacity: 1;
		}
	}
</style>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	private enum SortMode { NameAsc, NameDesc, UsageDesc }

	private class TagCreateForm
	{
		[Required(ErrorMessage = "Name is required")]
		[StringLength(40, MinimumLength = 1, ErrorMessage = "Name must be 1-40 characters")]
		public string Name { get; set; } = string.Empty;
	}

	private TagCreateForm _createForm = new();
	private SortMode _sortMode = SortMode.NameAsc;
	private Guid? _renamingId;
	private string _renameBuffer = string.Empty;
	private string? _bannerMessage;
	private bool _bannerIsError;
	private Dictionary<Guid, int> _usageCounts = new();
	private bool _wasVisible;
	private ElementReference _renameInputRef;
	private bool _focusRenameInput;

	private IEnumerable<Tag> SortedTags => _sortMode switch
	{
		SortMode.NameDesc => TagService.Tags.OrderByDescending(t => t.Name, StringComparer.OrdinalIgnoreCase),
		SortMode.UsageDesc => TagService.Tags
			.OrderByDescending(t => _usageCounts.TryGetValue(t.Id, out var c) ? c : 0)
			.ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase),
		_ => TagService.Tags.OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase),
	};

	protected override void OnInitialized()
	{
		TagService.OnTagsChanged += HandleTagsChanged;
	}

	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && !_wasVisible)
		{
			_createForm = new TagCreateForm();
			_renamingId = null;
			_bannerMessage = null;
			await TagService.InitializeAsync();
			await RefreshUsageCounts();
		}
		_wasVisible = IsVisible;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_focusRenameInput)
		{
			_focusRenameInput = false;
			try { await _renameInputRef.FocusAsync(); } catch { }
		}
	}

	private void HandleTagsChanged()
	{
		_ = InvokeAsync(async () =>
		{
			await RefreshUsageCounts();
			StateHasChanged();
		});
	}

	private async Task RefreshUsageCounts()
	{
		var fresh = new Dictionary<Guid, int>();
		foreach (var tag in TagService.Tags)
		{
			fresh[tag.Id] = await TagService.GetUsageCountAsync(tag.Id);
		}
		_usageCounts = fresh;
	}

	private async Task HandleCreate()
	{
		var name = (_createForm.Name ?? string.Empty).Trim();
		if (string.IsNullOrEmpty(name))
			return;

		var existed = TagService.Tags.Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
		await TagService.GetOrCreateAsync(name);
		_createForm = new TagCreateForm();

		if (existed)
		{
			ShowBanner($"Tag '{name}' already exists.", isError: false);
		}
		else
		{
			_bannerMessage = null;
		}
	}

	private void StartRename(Tag tag)
	{
		_renamingId = tag.Id;
		_renameBuffer = tag.Name;
		_bannerMessage = null;
		_focusRenameInput = true;
	}

	private void CancelRename()
	{
		_renamingId = null;
		_renameBuffer = string.Empty;
	}

	private async Task SaveRename(Tag tag)
	{
		var name = (_renameBuffer ?? string.Empty).Trim();
		if (string.IsNullOrEmpty(name))
		{
			ShowBanner("Tag name cannot be empty.", isError: true);
			return;
		}

		if (string.Equals(name, tag.Name, StringComparison.Ordinal))
		{
			CancelRename();
			return;
		}

		var updated = new Tag { Id = tag.Id, Name = name };
		var ok = await TagService.UpdateAsync(updated);
		if (!ok)
		{
			ShowBanner($"A tag named '{name}' already exists.", isError: true);
			return;
		}

		_renamingId = null;
		_renameBuffer = string.Empty;
	}

	private async Task OnRenameKeyDown(KeyboardEventArgs e, Tag tag)
	{
		if (e.Key == "Enter")
			await SaveRename(tag);
		else if (e.Key == "Escape")
			CancelRename();
	}

	private async Task HandleDelete(Tag tag)
	{
		var count = _usageCounts.TryGetValue(tag.Id, out var c) ? c : 0;
		if (count > 0)
		{
			var confirmed = await DialogService.ConfirmAsync(
				$"'{tag.Name}' is used on {count} todo{(count == 1 ? "" : "s")}. Deleting it will remove the tag from those todos. Continue?");
			if (!confirmed)
				return;
		}

		await TagService.DeleteAsync(tag);
		if (_renamingId == tag.Id)
			CancelRename();
	}

	private void ShowBanner(string message, bool isError)
	{
		_bannerMessage = message;
		_bannerIsError = isError;
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}

	public void Dispose()
	{
		TagService.OnTagsChanged -= HandleTagsChanged;
	}
}
