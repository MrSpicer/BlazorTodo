@using TodoList.Models
@using TodoList.Models.Enums
@using TodoList.Services
@using TodoList.Services.Access
@inject ITodoService TodoService
@inject IProjectMembershipService Membership

<Modal IsVisible="IsVisible" OnClose="Close" Title="@(IsEditing ? "Edit Task" : "New Task")">
	<HeaderIcon>
		@if (IsEditing)
		{
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
				<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
			</svg>
		}
		else
		{
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="3" y="3" width="18" height="18" rx="2"/>
				<path d="M12 8v8M8 12h8"/>
			</svg>
		}
	</HeaderIcon>
	<ChildContent>
		<TodoForm Todo="@_todo"
		          IsEditing="@IsEditing"
		          ShowCard="false"
		          Members="@_members"
		          OnSubmit="HandleSubmit"
		          OnCancel="Close"
		          OnConvertToNote="HandleConvertToNote">
			<BodyHeader>
				@if (ShowParentSelector)
				{
					<div class="form-group">
						<label for="parentTaskSelect" class="form-label">Parent</label>
						<select id="parentTaskSelect" class="form-input"
						        value="@(_selectedParentId?.ToString() ?? string.Empty)"
						        @onchange="e => _selectedParentId = string.IsNullOrEmpty(e.Value?.ToString()) ? (Guid?)null : Guid.Parse(e.Value!.ToString()!)">
							<option value="">None</option>
							@foreach (var p in GetAvailableParents())
							{
								<option value="@p.Id">@p.Title</option>
							}
						</select>
					</div>
				}
			</BodyHeader>
		</TodoForm>
	</ChildContent>
</Modal>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public bool IsEditing { get; set; }

	[Parameter]
	public TodoItem? EditingTodo { get; set; }

	[Parameter]
	public Guid? DefaultProjectId { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public EventCallback<TodoItem> OnSubmit { get; set; }

	[Parameter]
	public EventCallback<TodoItem> OnConvertToNote { get; set; }

	[Parameter]
	public bool ShowParentSelector { get; set; }

	[Parameter]
	public Guid? DefaultParentId { get; set; }

	private TodoItem _todo = new();
	private Guid? _selectedParentId;
	private Guid? _originalParentId;
	private IReadOnlyList<ProjectMemberView> _members = Array.Empty<ProjectMemberView>();
	private Guid _membersLoadedFor;

	// Load the project's members (for the Owner/Assignee selectors) whenever the modal targets a
	// new project. Returns empty for anonymous/local projects, which hides the selectors.
	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && _todo.ProjectId != Guid.Empty && _membersLoadedFor != _todo.ProjectId)
		{
			_membersLoadedFor = _todo.ProjectId;
			_members = await Membership.GetMembersAsync(_todo.ProjectId);
		}
		else if (!IsVisible)
		{
			_membersLoadedFor = Guid.Empty;
			_members = Array.Empty<ProjectMemberView>();
		}
	}

	protected override void OnParametersSet()
	{
		if (IsVisible)
		{
			if (IsEditing && EditingTodo != null)
			{
				_todo = new TodoItem
				{
					Id = EditingTodo.Id,
					Title = EditingTodo.Title,
					Description = EditingTodo.Description,
					Priority = EditingTodo.Priority,
					PriorityId = EditingTodo.PriorityId,
					Status = EditingTodo.Status,
					StatusId = EditingTodo.StatusId,
					CreatedAt = EditingTodo.CreatedAt,
					StartedAt = EditingTodo.StartedAt,
					CompletedAt = EditingTodo.CompletedAt,
					DueDate = EditingTodo.DueDate,
					EstimatedMinutes = EditingTodo.EstimatedMinutes,
					UpdatedAt = EditingTodo.UpdatedAt,
					ProjectId = EditingTodo.ProjectId,
					ParentId = EditingTodo.ParentId,
					OwnerId = EditingTodo.OwnerId,
					AssigneeId = EditingTodo.AssigneeId,
					TagIds = EditingTodo.TagIds.ToList(),
					ChangeLog = EditingTodo.ChangeLog.ToList(),
				};
				_originalParentId = EditingTodo.ParentId;
				_selectedParentId = EditingTodo.ParentId;
			}
			else
			{
				_todo = new TodoItem();
				if (DefaultProjectId.HasValue)
				{
					_todo.ProjectId = DefaultProjectId.Value;
				}
				_originalParentId = null;
				_selectedParentId = DefaultParentId;
			}
		}
	}

	private async Task HandleSubmit(TodoItem todo)
	{
		if (ShowParentSelector)
		{
			todo.ParentId = _selectedParentId;
			// Reparenting across projects: child follows its new parent's project.
			if (_selectedParentId.HasValue)
			{
				var newParent = TodoService.Todos.FirstOrDefault(t => t.Id == _selectedParentId.Value);
				if (newParent != null)
					todo.ProjectId = newParent.ProjectId;
			}
		}
		await OnSubmit.InvokeAsync(todo);
		await Close();
	}

	// 1-level depth policy: only top-level todos may be parents. Exclude self
	// (a todo can't parent itself) and completed-like todos (no point burying
	// new work under a done task). Scoped to the todo's own project.
	private IEnumerable<TodoItem> GetAvailableParents()
	{
		var selfId = EditingTodo?.Id ?? _todo.Id;
		return TodoService.Todos.Where(t =>
			t.ProjectId == _todo.ProjectId &&
			t.ParentId is null &&
			t.Id != selfId &&
			!BuiltInStatusIds.IsCompletedLike(t.StatusId));
	}

	private async Task HandleConvertToNote(TodoItem todo)
	{
		await OnConvertToNote.InvokeAsync(todo);
		await Close();
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}
}
