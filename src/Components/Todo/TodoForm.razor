@using TodoList.Models
@using TodoList.Models.Enums
@using TodoList.Helpers
@using TodoList.Services.Access
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IPriorityService PriorityService
@inject ITodoService TodoService

<EditForm Model="@Todo" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <EditorPageShell Heading="@(IsEditing ? "Edit Task" : "New Task")"
                     BackHref="@BackHref"
                     BackLabel="@BackLabel"
                     SubmitLabel="@(IsEditing ? "Save Changes" : "Add Task")"
                     ErrorMessage="@ErrorMessage"
                     OnCancel="OnCancel">
        <LeadingActions>
            @if (IsEditing && OnConvertToNote.HasDelegate)
            {
                <button type="button" class="btn btn-ghost" @onclick="() => OnConvertToNote.InvokeAsync(Todo)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    Convert to Note
                </button>
            }
        </LeadingActions>

        <MainContent>
            <div class="form-group">
                <label for="TodoTitle" class="form-label">Title</label>
                <InputText id="TodoTitle" class="form-input editor-title-input" @bind-Value="Todo.Title"
                           placeholder="What needs to be done?" />
                <ValidationMessage For="@(() => Todo.Title)" class="validation-error" />
            </div>

            <div class="form-group">
                <label for="TodoDescription" class="form-label">Description</label>
                <InputTextArea id="TodoDescription" class="form-input form-textarea editor-body-textarea"
                               @bind-Value="Todo.Description" placeholder="Add some details..." />
                <ValidationMessage For="@(() => Todo.Description)" class="validation-error" />
            </div>
        </MainContent>

        <SideRail>
            <div class="form-group">
                <label for="parentTaskSelect" class="form-label">Parent</label>
                <select id="parentTaskSelect" class="form-input"
                        value="@(_selectedParentId?.ToString() ?? string.Empty)"
                        @onchange="OnParentChanged">
                    <option value="">None</option>
                    @foreach (var p in GetAvailableParents())
                    {
                        <option value="@p.Id">@p.Title</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="TodoDueDate" class="form-label">Due date</label>
                <div class="due-date-wrap">
                    <InputDate Type="InputDateType.DateTimeLocal" id="TodoDueDate" class="form-input"
                               @bind-Value="Todo.DueDate" />
                    @if (Todo.DueDate.HasValue)
                    {
                        <button type="button" class="btn-clear-due" @onclick="() => Todo.DueDate = null"
                                aria-label="Clear due date" data-testid="clear-due-date">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="TodoEstimate" class="form-label">Estimate (minutes)</label>
                <InputNumber id="TodoEstimate" class="form-input" @bind-Value="Todo.EstimatedMinutes" placeholder="e.g. 30" />
            </div>

            <div class="form-group">
                <label class="form-label">Priority</label>
                <div class="priority-options">
                    @foreach (var priority in PriorityService.Priorities.OrderBy(p => p.Rank))
                    {
                        var isSelected = Todo.PriorityId == priority.Id;
                        var (bg, fg) = StatusColor.Resolve(priority.Color);
                        <label class="priority-option @(isSelected ? "selected" : "")"
                               style="@(isSelected ? $"background:{bg};border-color:{priority.Color};color:{fg};" : "")">
                            <input type="radio" name="priority" value="@priority.Id" checked="@isSelected"
                                   @onchange="() => Todo.PriorityId = priority.Id" />
                            <span class="priority-dot" style="background-color:@priority.Color"></span>
                            <span class="priority-label">@priority.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Tags</label>
                <TagSelector @bind-SelectedTagIds="Todo.TagIds" />
            </div>

            @if (AssignableMembers.Count > 1)
            {
                <div class="form-group">
                    <label class="form-label" for="TodoOwner">Owner</label>
                    <select id="TodoOwner" class="form-input" value="@Todo.OwnerId" @onchange="OnOwnerChanged">
                        @foreach (var m in AssignableMembers)
                        {
                            <option value="@m.UserId">@MemberLabel(m)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="TodoAssignee">Assignee</label>
                    <select id="TodoAssignee" class="form-input"
                            value="@(Todo.AssigneeId?.ToString() ?? string.Empty)" @onchange="OnAssigneeChanged">
                        <option value="">Unassigned</option>
                        @foreach (var m in AssignableMembers)
                        {
                            <option value="@m.UserId">@MemberLabel(m)</option>
                        }
                    </select>
                </div>
            }
        </SideRail>
    </EditorPageShell>
</EditForm>

<style>
    .due-date-wrap {
        position: relative;
    }

    .btn-clear-due {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 22px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: var(--gray-100);
        color: var(--text-muted);
        border-radius: var(--radius-full);
        cursor: pointer;
    }

    .btn-clear-due:hover {
        background: var(--gray-200);
        color: var(--text-primary);
    }

    .priority-options {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    .priority-option {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-lg);
        cursor: pointer;
        transition: all var(--transition-fast);
        font-size: 0.875rem;
        font-weight: 500;
    }

    .priority-option input {
        display: none;
    }

    .priority-option:hover {
        border-color: var(--gray-300);
        background: var(--surface-hover);
    }

    .priority-dot {
        width: 10px;
        height: 10px;
        border-radius: var(--radius-full);
    }
</style>

@code {
    [Parameter, EditorRequired] public TodoItem Todo { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public string BackHref { get; set; } = "/";
    [Parameter] public string BackLabel { get; set; } = "Back";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback<TodoItem> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TodoItem> OnConvertToNote { get; set; }

    /// <summary>Owner + accepted members of the todo's project. Owner/Assignee selectors show only
    /// when the project is actually shared (more than one assignable member).</summary>
    [Parameter] public IReadOnlyList<ProjectMemberView> Members { get; set; } = Array.Empty<ProjectMemberView>();

    private Guid? _selectedParentId;

    // Seeded once: the host page only renders this component after its data has loaded, so Todo is
    // final by the time OnInitialized runs, and later re-renders must not clobber the user's choice.
    protected override void OnInitialized()
    {
        _selectedParentId = Todo.ParentId;
        PriorityService.OnPrioritiesChanged += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        if (Todo.PriorityId == Guid.Empty)
            Todo.PriorityId = BuiltInPriorityIds.Medium;
    }

    public void Dispose() => PriorityService.OnPrioritiesChanged -= StateHasChanged;

    private IReadOnlyList<ProjectMemberView> AssignableMembers =>
        Members.Where(m => m.IsOwner || m.Status == ProjectMemberStatus.Accepted).ToList();

    private static string MemberLabel(ProjectMemberView m) =>
        string.IsNullOrWhiteSpace(m.DisplayName) ? m.Email : m.DisplayName;

    private void OnParentChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _selectedParentId = string.IsNullOrEmpty(v) ? null : Guid.Parse(v);
    }

    private void OnOwnerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var g)) Todo.OwnerId = g;
    }

    private void OnAssigneeChanged(ChangeEventArgs e)
    {
        Todo.AssigneeId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
    }

    // 1-level depth policy: only top-level todos may be parents. Exclude self and completed-like
    // todos. Scoped to the todo's own project. (Ported from TodoFormModal.GetAvailableParents.)
    private IEnumerable<TodoItem> GetAvailableParents() =>
        TodoService.Todos.Where(t =>
            t.ProjectId == Todo.ProjectId &&
            t.ParentId is null &&
            t.Id != Todo.Id &&
            !BuiltInStatusIds.IsCompletedLike(t.StatusId));

    // Ported from TodoFormModal.HandleSubmit: apply the chosen parent, and when reparenting,
    // the child follows its new parent's project.
    private async Task HandleValidSubmit()
    {
        Todo.ParentId = _selectedParentId;
        if (_selectedParentId.HasValue)
        {
            var newParent = TodoService.Todos.FirstOrDefault(t => t.Id == _selectedParentId.Value);
            if (newParent != null) Todo.ProjectId = newParent.ProjectId;
        }
        await OnSubmit.InvokeAsync(Todo);
    }
}
