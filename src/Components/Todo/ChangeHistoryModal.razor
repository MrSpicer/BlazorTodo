@using TodoList.Models
@inject ITagService TagService

<Modal IsVisible="@(IsVisible && Item is not null)" OnClose="HandleClose" Title="Change History" Size="wide">
	<HeaderIcon>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M3 3v5h5" />
			<path d="M3.05 13A9 9 0 1 0 6 5.3L3 8" />
			<path d="M12 7v5l4 2" />
		</svg>
	</HeaderIcon>
	<BodyContent>
		@if (Item is not null)
		{
			<p class="modal-subtitle">@Item.Title</p>
			@if (Item.ChangeLog.Count == 0)
			{
				<p class="empty-history">No changes recorded yet.</p>
			}
			else
			{
				<div class="history-scroll">
					<table class="history-table" data-testid="history-table">
						<thead>
							<tr>
								<th>When</th>
								<th>Field</th>
								<th>From</th>
								<th>To</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var entry in Item.ChangeLog.OrderByDescending(e => e.ChangedAt))
							{
								<tr>
									<td class="history-when">@entry.ChangedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
									<td class="history-field">@entry.Field</td>
									<td class="history-old">@(string.IsNullOrEmpty(entry.OldValue) ? "—" : entry.OldValue)</td>
									<td class="history-new">@(string.IsNullOrEmpty(entry.NewValue) ? "—" : entry.NewValue)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	</BodyContent>
</Modal>

<style>
	.modal-subtitle {
		margin: 0 0 var(--space-3);
		color: var(--text-secondary);
		font-size: 0.875rem;
	}

	.empty-history {
		color: var(--text-muted);
		font-style: italic;
	}

	.history-scroll {
		overflow-x: auto;
	}

	.history-table {
		width: 100%;
		min-width: 480px;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.history-table th {
		text-align: left;
		padding: var(--space-2) var(--space-3);
		border-bottom: 2px solid var(--border-light);
		color: var(--text-secondary);
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.history-table td {
		padding: var(--space-2) var(--space-3);
		border-bottom: 1px solid var(--border-light);
		vertical-align: top;
	}

	.history-when {
		color: var(--text-secondary);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.history-field {
		font-weight: 600;
		color: var(--text-primary);
	}

	.history-old {
		color: var(--text-muted);
		text-decoration: line-through;
	}

	.history-new {
		color: var(--success);
		font-weight: 500;
	}
</style>

@code {
	[Parameter, EditorRequired]
	public bool IsVisible { get; set; }

	[Parameter]
	public TodoItem? Item { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	private async Task HandleClose() => await OnClose.InvokeAsync();
}
