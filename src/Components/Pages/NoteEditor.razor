@page "/notes/new"
@page "/notes/{Id:guid}/edit"
@inherits PageComponentBase
@using TodoList.Services.Access
@inject IProjectService ProjectService
@inject INoteService NoteService
@inject ITodoService TodoService
@inject IProjectAccessResolver Access
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>BlazorTodo - @(IsEditing ? "Edit Note" : "New Note")</PageTitle>

@if (_isLoading)
{
    <div class="editor-page" aria-busy="true" aria-live="polite">
        <div class="skeleton-shell">
            <div class="skeleton-row" style="height: 32px; max-width: 420px;"></div>
            <div class="editor-grid single" style="margin-top: var(--space-6);">
                <div class="skeleton-list">
                    <div class="skeleton-row" style="height: 36px;"></div>
                    <div class="skeleton-row" style="height: 320px;"></div>
                </div>
            </div>
        </div>
    </div>
}
else if (_notFound)
{
    <div class="editor-page">
        <h1 class="editor-title">Note not found</h1>
        <p class="editor-empty-text">This note doesn't exist anymore — it may have been deleted on another device.</p>
        <a class="btn btn-primary" href="@_backHref">Go back</a>
    </div>
}
else if (_noProject)
{
    <div class="editor-page">
        <h1 class="editor-title">No project selected</h1>
        <p class="editor-empty-text">Notes live inside a project. Pick or create one first, then add the note.</p>
        <a class="btn btn-primary" href="@_backHref">Go back</a>
    </div>
}
else if (_noPermission)
{
    <div class="editor-page">
        <h1 class="editor-title">No permission</h1>
        <p class="editor-empty-text">You don't have permission to @(IsEditing ? "edit" : "add") notes in this project.</p>
        <a class="btn btn-primary" href="@_backHref">Go back</a>
    </div>
}
else
{
    <EditForm Model="@_note" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <EditorPageShell Heading="@(IsEditing ? "Edit Note" : "New Note")"
                         BackHref="@_backHref"
                         BackLabel="@_backLabel"
                         Crumb="@_crumb"
                         SubmitLabel="@(IsEditing ? "Save Changes" : "Add Note")"
                         ErrorMessage="@_error"
                         OnCancel="GoBack">
            <LeadingActions>
                @if (IsEditing)
                {
                    <button type="button" class="btn btn-ghost" @onclick="HandleConvertToTodo" data-testid="convert-note-to-task">
                        Convert to Task
                    </button>
                }
            </LeadingActions>
            <MainContent>
                <div class="form-group">
                    <label class="form-label" for="note-title">Title</label>
                    <InputText id="note-title" class="form-input editor-title-input"
                               @bind-Value="_note.Title" placeholder="Note title..." />
                    <ValidationMessage For="@(() => _note.Title)" class="validation-error" />
                </div>
                <div class="form-group">
                    <div class="editor-label-row">
                        <label class="form-label" for="note-content">Content</label>
                        <span class="editor-count" data-testid="note-content-count">@_note.Content.Length.ToString("N0") characters</span>
                    </div>
                    @* Same as the task description: the field is uncapped, and maxlength is only the
                       transport guard that keeps an oversized paste from dropping the circuit. *@
                    <InputTextArea id="note-content" class="form-input form-textarea editor-body-textarea"
                                   maxlength="@CircuitLimits.MaxTextFieldChars"
                                   @bind-Value="_note.Content" placeholder="Write your note here..." />
                    <ValidationMessage For="@(() => _note.Content)" class="validation-error" />
                </div>
            </MainContent>
        </EditorPageShell>
    </EditForm>
}

@code {
    // Route value on the /notes/{Id:guid}/edit route; stays null on /notes/new.
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isLoading = true;
    private bool _loaded;
    private Guid? _loadedId;
    private bool _notFound;
    private bool _noProject;
    private bool _noPermission;
    private string? _error;
    // Non-nullable so ValidationMessage/For and @bind codegen can infer member types. The
    // not-found / no-permission flags gate the form, not the field.
    private ProjectNote _note = new();
    private string _backHref = "/";
    private string _backLabel = "Back to Notes";
    private string _crumb = string.Empty;

    private bool IsEditing => Id is not null;

    protected override async Task OnFirstRenderAsync()
    {
        if (_loaded) return;
        _loaded = true;
        await LoadAsync();
    }

    // RouteView reuses this instance when the route changes to another note, so OnFirstRenderAsync
    // won't run again — reload explicitly or the form stays bound to the previously loaded note
    // while the URL (and a subsequent save) points at a different one.
    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded || Id == _loadedId) return;
        ResetState();
        await LoadAsync();
        StateHasChanged();
    }

    private void ResetState()
    {
        _isLoading = true;
        _notFound = false;
        _noProject = false;
        _noPermission = false;
        _error = null;
        _note = new ProjectNote();
        _crumb = string.Empty;
    }

    private async Task LoadAsync()
    {
        _loadedId = Id;
        _backHref = EditorRoutes.SafeReturn(ReturnUrl);

        await Task.WhenAll(
            ProjectService.InitializeAsync(),
            NoteService.InitializeAsync());

        if (IsEditing)
        {
            // Deep-copy the cached item so a mid-edit sync refresh can't reach in and clobber
            // fields the user is typing into.
            var original = NoteService.GetById(Id!.Value);
            if (original is null)
            {
                _notFound = true;
                _isLoading = false;
                return;
            }
            _note = new ProjectNote
            {
                Id = original.Id,
                UserId = original.UserId,
                ProjectId = original.ProjectId,
                Title = original.Title,
                Content = original.Content,
                CreatedAt = original.CreatedAt,
                UpdatedAt = original.UpdatedAt
            };
        }
        else
        {
            var projectId = ProjectId ?? ProjectService.SelectedProject?.Id ?? Guid.Empty;
            if (projectId == Guid.Empty)
            {
                _noProject = true;
                _isLoading = false;
                return;
            }
            _note = new ProjectNote
            {
                ProjectId = projectId
            };
        }

        var requiredPerm = IsEditing ? ProjectPermission.NotesModify : ProjectPermission.NotesAdd;
        var perms = await PermissionResolver.ForProjectAsync(AuthState, Access, _note.ProjectId);
        if (!perms.HasFlag(requiredPerm))
        {
            _noPermission = true;
            _isLoading = false;
            return;
        }

        var project = ProjectService.Projects.FirstOrDefault(p => p.Id == _note.ProjectId);
        if (project is not null)
        {
            _backLabel = $"Back to {project.Name}";
            _crumb = project.Name;
            // See TodoEditor: the list page shows whichever project ProjectService has selected,
            // so align it with this note or every exit route lands on the default project.
            ProjectService.SelectProject(project);
        }
        _isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        var saved = await NoteService.SaveNoteAsync(_note);
        if (!saved)
        {
            _error = "Couldn't save this note. Check that you still have access to the project.";
            return;
        }
        GoBack();
    }

    private async Task HandleConvertToTodo()
    {
        if (!await DialogService.ConfirmAsync(
            "Convert this note to a task? Note content will become the task description.",
            "Convert to Task"))
            return;

        await TodoService.InitializeAsync();
        var todo = new TodoItem
        {
            ProjectId = _note.ProjectId,
            Title = _note.Title,
            Description = _note.Content
        };
        // A note title can be longer than a task title (200 vs 100), so check up front and name the
        // field that actually overflowed — the note is only deleted once the task is safely saved.
        // The body never overflows: both are uncapped.
        if (!EntityValidation.TryValidate(todo, out var problem))
        {
            _error = $"Couldn't convert this note to a task — {problem}. The note was kept.";
            return;
        }
        if (!await TodoService.SaveTodoAsync(todo))
        {
            _error = "Couldn't create the task, so the note was kept.";
            return;
        }
        await NoteService.DeleteNoteAsync(_note);
        NavigateAfterConvert("/?tab=tasks");
    }

    // Returning to a different page (say /kanban) keeps the user where they were. Returning to the
    // list page itself should land on the tab the converted item now lives in, not the one it left.
    private void NavigateAfterConvert(string tabUrl)
    {
        var isListPage = _backHref == "/" || _backHref.StartsWith("/?", StringComparison.Ordinal);
        NavigationManager.NavigateTo(isListPage ? tabUrl : _backHref);
    }

    private void GoBack() => NavigationManager.NavigateTo(_backHref);
}
