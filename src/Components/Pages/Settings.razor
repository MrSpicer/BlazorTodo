@page "/settings"
@using TodoList.Identity
@inject IImportExportService ImportExportService
@inject IFileService FileService
@inject IDialogService DialogService
@inject IFilterPresetService PresetService
@inject ILocalDataMigrationService MigrationService
@inject ICurrentUserContext UserContext
@inject NavigationManager NavigationManager
@inherits PageComponentBase

<PageTitle>BlazorTodo - Settings</PageTitle>

<h1 class="page-title">Settings</h1>

<div class="settings-sections">

	<!-- Import / Export -->
	<div class="settings-card">
		<div class="settings-card-header">
			<div class="settings-card-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
					<polyline points="17 8 12 3 7 8"/>
					<line x1="12" y1="3" x2="12" y2="15"/>
				</svg>
			</div>
			<div>
				<h2 class="settings-card-title">Import / Export</h2>
				<p class="settings-card-description">Download all your todos as a JSON file, or import from a previously exported file.</p>
			</div>
		</div>
		<div class="settings-card-actions">
			<button class="btn btn-outline-secondary" @onclick="ShowImportExportModal">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
					<polyline points="17 8 12 3 7 8"/>
					<line x1="12" y1="3" x2="12" y2="15"/>
				</svg>
				Import / Export
			</button>
		</div>
	</div>

	<!-- Tags -->
	<div class="settings-card">
		<div class="settings-card-header">
			<div class="settings-card-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
					<line x1="7" y1="7" x2="7.01" y2="7"/>
				</svg>
			</div>
			<div>
				<h2 class="settings-card-title">Tags</h2>
				<p class="settings-card-description">Create, rename, sort, and delete tags used to label your todos.</p>
			</div>
		</div>
		<div class="settings-card-actions">
			<button class="btn btn-outline-secondary" @onclick="ShowTagsModal">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
					<line x1="7" y1="7" x2="7.01" y2="7"/>
				</svg>
				Manage Tags
			</button>
		</div>
	</div>

	<!-- Statuses -->
	<div class="settings-card">
		<div class="settings-card-header">
			<div class="settings-card-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/>
					<path d="M9 12l2 2 4-4"/>
				</svg>
			</div>
			<div>
				<h2 class="settings-card-title">Statuses</h2>
				<p class="settings-card-description">Add custom statuses or rename and recolor the built-in ones used to track todo progress.</p>
			</div>
		</div>
		<div class="settings-card-actions">
			<button class="btn btn-outline-secondary" @onclick="ShowStatusModal">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/>
					<path d="M9 12l2 2 4-4"/>
				</svg>
				Manage Statuses
			</button>
		</div>
	</div>

	<!-- Priorities -->
	<div class="settings-card">
		<div class="settings-card-header">
			<div class="settings-card-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 22V4M4 4l8 4-8 4M4 14l12 4-12 4"/>
				</svg>
			</div>
			<div>
				<h2 class="settings-card-title">Priorities</h2>
				<p class="settings-card-description">Add custom priorities or rename, recolor, and reorder the built-in ones used to rank todos.</p>
			</div>
		</div>
		<div class="settings-card-actions">
			<button class="btn btn-outline-secondary" @onclick="ShowPriorityModal">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 22V4M4 4l8 4-8 4M4 14l12 4-12 4"/>
				</svg>
				Manage Priorities
			</button>
		</div>
	</div>

	<!-- Filter Presets -->
	<div class="settings-card">
		<div class="settings-card-header">
			<div class="settings-card-icon">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M3 4h18M6 12h12M10 20h4"/>
				</svg>
			</div>
			<div>
				<h2 class="settings-card-title">Filter Presets</h2>
				<p class="settings-card-description">Remember your selected filter preset across sessions. When enabled, Reset to Defaults restores your selected preset; when disabled, it restores the built-in defaults.</p>
			</div>
		</div>
		<div class="settings-card-actions">
			<label class="setting-toggle">
				<input type="checkbox"
				       checked="@PresetService.RememberPresets"
				       @onchange="HandleRememberPresetsChanged" />
				<span>Remember filter presets</span>
			</label>
		</div>
	</div>

	<!-- Project Members & Access -->
	@if (UserContext.IsAuthenticated)
	{
		<div class="settings-card">
			<div class="settings-card-header">
				<div class="settings-card-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
						<circle cx="9" cy="7" r="4"/>
						<path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
					</svg>
				</div>
				<div>
					<h2 class="settings-card-title">Project Members &amp; Access</h2>
					<p class="settings-card-description">Manage who can access your projects, change member roles, remove members, and delegate access management to specific members or roles.</p>
				</div>
			</div>
			<div class="settings-card-actions">
				<button class="btn btn-outline-secondary" @onclick="ShowMembersModal">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
						<circle cx="9" cy="7" r="4"/>
						<path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
					</svg>
					Manage Members
				</button>
			</div>
		</div>
	}

	<!-- Upload local data to account -->
	@if (_canUploadLocalData)
	{
		<div class="settings-card">
			<div class="settings-card-header">
				<div class="settings-card-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
						<polyline points="16 16 12 12 8 16"/>
						<line x1="12" y1="12" x2="12" y2="21"/>
					</svg>
				</div>
				<div>
					<h2 class="settings-card-title">Upload local data to your account</h2>
					<p class="settings-card-description">This browser has to-dos, projects, or notes created before you signed in. Upload them to merge them into your account, then remove them from this browser.</p>
				</div>
			</div>
			<div class="settings-card-actions">
				<button class="btn btn-outline-secondary" @onclick="HandleUploadLocalData" disabled="@_isUploadingLocalData">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
						<polyline points="16 16 12 12 8 16"/>
						<line x1="12" y1="12" x2="12" y2="21"/>
					</svg>
					@(_isUploadingLocalData ? "Uploading…" : "Upload to account")
				</button>
			</div>
		</div>
	}

	<!-- Danger Zone -->
	@if (_canClearLocalStorage)
	{
		<div class="settings-card danger-zone">
			<div class="settings-card-header">
				<div class="settings-card-icon danger">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
						<line x1="12" y1="9" x2="12" y2="13"/>
						<line x1="12" y1="17" x2="12.01" y2="17"/>
					</svg>
				</div>
				<div>
					<h2 class="settings-card-title">Danger Zone</h2>
					<p class="settings-card-description">Permanently delete the todos, projects, and notes stored locally in this browser. This only affects anonymous data on this device — it does not touch data saved to your account. This cannot be undone.</p>
				</div>
			</div>
			<div class="settings-card-actions">
				<button class="btn btn-ghost danger" @onclick="HandleClearLocalStorage">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
					</svg>
					Clear All Local Storage
				</button>
			</div>
		</div>
	}

</div>

<!-- Modals -->
<ImportExportModal IsVisible="@_showImportExportModal"
                   OnClose="HideImportExportModal"
                   OnExport="HandleExport"
                   OnImport="HandleImport"
                   @ref="_importExportModal" />

<TagsModal IsVisible="@_showTagsModal" OnClose="HideTagsModal" />

<StatusManagementModal IsVisible="@_showStatusModal" OnClose="HideStatusModal" />

<PriorityManagementModal IsVisible="@_showPriorityModal" OnClose="HidePriorityModal" />

<ProjectMembersModal IsVisible="@_showMembersModal" OnClose="HideMembersModal" />

<style>
	.settings-sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: 700px;
	}

	.settings-card {
		background: var(--surface);
		border: 1px solid var(--border-light);
		border-radius: var(--radius-lg);
		padding: var(--space-5) var(--space-6);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		transition: border-color var(--transition-fast);
	}

	.settings-card:hover {
		border-color: var(--border);
	}

	.settings-card.danger-zone {
		border-color: var(--danger-light);
	}

	.settings-card.danger-zone:hover {
		border-color: var(--danger);
	}

	.settings-card-header {
		display: flex;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.settings-card-icon {
		width: 44px;
		height: 44px;
		border-radius: var(--radius-lg);
		background: var(--primary-50);
		color: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.settings-card-icon.danger {
		background: var(--danger-light);
		color: var(--danger);
	}

	.settings-card-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		margin: 0 0 var(--space-1);
	}

	.settings-card-description {
		font-size: 0.875rem;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.5;
	}

	.settings-card-actions {
		flex-shrink: 0;
	}

	.setting-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.9375rem;
		color: var(--text-primary);
		cursor: pointer;
	}

	.setting-toggle input[type="checkbox"] {
		width: 18px;
		height: 18px;
		cursor: pointer;
	}

	.btn-ghost.danger {
		color: var(--danger);
	}

	.btn-ghost.danger:hover {
		background: var(--danger-light);
	}

	@@media (max-width: 640px) {
		.settings-card {
			flex-direction: column;
			align-items: stretch;
		}

		.settings-card-actions {
			display: flex;
		}
		.settings-card-actions .btn {
			flex: 1;
			justify-content: center;
		}
	}
</style>

@code {
	private bool _showImportExportModal;
	private bool _showTagsModal;
	private bool _showStatusModal;
	private bool _showPriorityModal;
	private bool _showMembersModal;
	private ImportExportModal? _importExportModal;
	private bool _canUploadLocalData;
	private bool _isUploadingLocalData;
	private bool _canClearLocalStorage;

	protected override void OnInitialized()
	{
		PresetService.OnPresetsChanged += StateHasChanged;
		Track(() => PresetService.OnPresetsChanged -= StateHasChanged);
	}

	protected override async Task OnFirstRenderAsync()
	{
		await PresetService.InitializeAsync();
		_canUploadLocalData = UserContext.IsAuthenticated && await MigrationService.HasLocalDataAsync();
		_canClearLocalStorage = await MigrationService.HasLocalProjectsAsync();
		StateHasChanged();
	}

	private async Task HandleRememberPresetsChanged(ChangeEventArgs e)
	{
		var enabled = e.Value is bool b && b;
		var seed = enabled ? (PresetService.RememberedPresetName ?? FilterPreset.DefaultName) : null;
		await PresetService.SetRememberPresetsAsync(enabled, seed);
	}

	private void ShowImportExportModal() => _showImportExportModal = true;
	private void HideImportExportModal() => _showImportExportModal = false;
	private void ShowTagsModal() => _showTagsModal = true;
	private void HideTagsModal() => _showTagsModal = false;
	private void ShowStatusModal() => _showStatusModal = true;
	private void HideStatusModal() => _showStatusModal = false;
	private void ShowPriorityModal() => _showPriorityModal = true;
	private void HidePriorityModal() => _showPriorityModal = false;
	private void ShowMembersModal() => _showMembersModal = true;
	private void HideMembersModal() => _showMembersModal = false;

	private async Task HandleExport()
	{
		var json = await ImportExportService.ExportToJsonAsync();
		var fileName = $"todos-export-{DateTime.Now:yyyy-MM-dd-HHmmss}.json";
		await FileService.DownloadFileAsync(fileName, json);
	}

	private async Task HandleImport((string Content, bool ReplaceExisting) args)
	{
		var result = await ImportExportService.ImportFromJsonAsync(args.Content, args.ReplaceExisting);

		if (result.Success)
		{
			var message = $"Successfully imported {result.ImportedCount} item(s).";
			if (result.RemappedToDefaultCount > 0)
				message += $" {result.RemappedToDefaultCount} moved to the default project.";
			if (result.SkippedCount > 0)
				message += $" Skipped {result.SkippedCount} failed item(s).";
			foreach (var warning in result.Warnings)
				message += $" {warning}";
			_importExportModal?.ShowMessage(message, false);
		}
		else
		{
			_importExportModal?.ShowMessage(result.ErrorMessage ?? "Import failed.", true);
		}
	}

	private async Task HandleUploadLocalData()
	{
		if (!await DialogService.ConfirmAsync("Upload local data to your account? This merges the todos, projects, and notes stored in this browser into your account, then removes them from this browser."))
			return;

		_isUploadingLocalData = true;
		var result = await MigrationService.MigrateAsync();
		_isUploadingLocalData = false;

		if (result.Success)
		{
			_canUploadLocalData = false;
			_canClearLocalStorage = false;
			var message = $"Uploaded {result.ImportedCount} item(s) to your account.";
			if (result.RemappedToDefaultCount > 0)
				message += $" {result.RemappedToDefaultCount} moved to the default project.";
			if (result.SkippedCount > 0)
				message += $" {result.SkippedCount} skipped.";
			await DialogService.AlertAsync(message, "Upload complete");
		}
		else
		{
			await DialogService.AlertAsync(result.ErrorMessage ?? "Upload failed. Please try again.", "Upload failed");
		}
	}

	private async Task HandleClearLocalStorage()
	{
		if (await DialogService.ConfirmAsync("Clear local storage? This permanently deletes the todos, projects, and notes stored in this browser. Data saved to your account is not affected. This cannot be undone."))
		{
			await MigrationService.ClearLocalDataAsync();
			NavigationManager.NavigateTo("/", forceLoad: true);
		}
	}
}
