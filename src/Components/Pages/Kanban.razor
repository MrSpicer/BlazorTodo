@page "/kanban"
@inherits PageComponentBase
@inject ITodoService TodoService
@inject IProjectService ProjectService
@inject IStatusService StatusService
@inject IPriorityService PriorityService
@inject ITagService TagService
@inject IDialogService DialogService
@inject IFilterPresetService PresetService
@inject TodoList.Services.Access.IProjectAccessResolver Access
@inject NavigationManager NavigationManager

<PageTitle>BlazorTodo - Board</PageTitle>

@if (_isLoading)
{
    <div class="kanban-loading" aria-busy="true" aria-live="polite">
        <div class="kanban-skeleton-lane"></div>
        <div class="kanban-skeleton-lane"></div>
        <div class="kanban-skeleton-lane"></div>
    </div>
}
else if (!ProjectService.Projects.Any())
{
    <div class="kanban-empty">
        <div class="kanban-empty-icon">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="6" height="18" rx="1"/>
                <rect x="10" y="3" width="6" height="12" rx="1"/>
                <rect x="17" y="3" width="4" height="8" rx="1"/>
            </svg>
        </div>
        <h1 class="kanban-empty-title">No projects yet</h1>
        <p class="kanban-empty-desc">Create a project on the Todos page to start using the board.</p>
        <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/")'>Go to Todos</button>
    </div>
}
else
{
    <ProjectTabs Projects="@ProjectService.Projects"
                 SelectedProject="@ProjectService.SelectedProject"
                 Todos="@TodoService.Todos"
                 PermissionsByProject="@_projectPerms"
                 OnProjectSelected="HandleProjectSelected"
                 OnNewProjectClick='() => NavigationManager.NavigateTo("/")' />

    <div class="action-bar">
        <div class="action-bar-left">
            @if (_perms.HasFlag(ProjectPermission.TodosAdd))
            {
                <button class="btn btn-primary" @onclick="ShowTodoModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Add Task
                </button>
            }
        </div>
    </div>

    <TodoFilters FilterCriteria="@_filterCriteria"
                 TotalCount="@GetProjectTodoCount()"
                 FilteredCount="@_filteredCount"
                 SelectedPresetName="@_selectedPresetName"
                 SelectedPresetChanged="HandleSelectedPresetChanged"
                 FilterChanged="StateHasChanged" />

    <div class="kanban-area">
        @{
            var projectId = ProjectService.SelectedProject?.Id;
            var filtered = TodoService.GetFilteredAndSorted(_filterCriteria, projectId).ToList();
            _filteredCount = filtered.Count;
            var lanes = StatusService.Statuses
                .Where(s => _filterCriteria.SelectedStatuses.Contains(s.Id))
                .OrderBy(s => BuiltInStatusIds.NaturalOrder(s.Id))
                .ThenBy(s => s.Name)
                .ToList();
        }

        @if (lanes.Count == 0)
        {
            <div class="kanban-no-lanes">
                No status lanes selected. Enable statuses in the <strong>Filters</strong> panel to show lanes.
            </div>
        }
        else
        {
            <div class="kanban-board" data-testid="kanban-board">
                @foreach (var status in lanes)
                {
                    var (bg, fg) = StatusColor.Resolve(status.Color);
                    var laneItems = filtered.Where(t => t.StatusId == status.Id).ToList();
                    var sid = status.Id;
                    <div class="kanban-lane @(_dragOverStatusId == sid ? "drag-over" : "")"
                         @ondragover:preventDefault="true"
                         @ondragenter="() => _dragOverStatusId = sid"
                         @ondragleave="() => OnLaneDragLeave(sid)"
                         @ondrop="() => HandleDrop(sid)"
                         data-testid="kanban-lane"
                         data-status-id="@sid">
                        <div class="kanban-lane-header" style="background-color:@bg;color:@fg">
                            <span class="kanban-lane-name">@status.Name</span>
                            <span class="kanban-lane-count" style="color:@fg">@laneItems.Count</span>
                        </div>
                        <div class="kanban-lane-body">
                            @foreach (var item in laneItems)
                            {
                                <KanbanCard @key="item.Id"
                                            Item="item"
                                            CanDrag="_perms.HasFlag(ProjectPermission.TodosModify)"
                                            OnEdit="HandleEdit"
                                            OnDragStart="HandleDragStart" />
                            }
                            @if (laneItems.Count == 0)
                            {
                                <div class="kanban-lane-empty">Drop here</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<TodoFormModal IsVisible="@_showTodoModal"
               IsEditing="@_isEditing"
               EditingTodo="@_currentTodo"
               DefaultProjectId="@ProjectService.SelectedProject?.Id"
               ShowParentSelector="true"
               OnClose="HideTodoModal"
               OnSubmit="HandleFormSubmit" />

<style>
    .kanban-board {
        display: flex;
        gap: var(--space-4);
        overflow-x: auto;
        padding-bottom: var(--space-4);
        align-items: flex-start;
    }

    .kanban-lane {
        flex: 0 0 300px;
        max-width: 300px;
        background: var(--gray-50);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        max-height: calc(100vh - 320px);
        transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
    }

    .kanban-lane.drag-over {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-light);
    }

    .kanban-lane-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3);
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .kanban-lane-name {
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .kanban-lane-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 var(--space-2);
        background: rgba(255, 255, 255, 0.55);
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .kanban-lane-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3);
        overflow-y: auto;
        flex: 1;
        min-height: 80px;
    }

    .kanban-lane-empty {
        text-align: center;
        color: var(--text-muted);
        font-size: 0.8125rem;
        padding: var(--space-5) var(--space-3);
        border: 2px dashed var(--border);
        border-radius: var(--radius-md);
    }

    .kanban-no-lanes {
        padding: var(--space-6);
        text-align: center;
        color: var(--text-secondary);
        background: var(--surface);
        border: 2px dashed var(--border);
        border-radius: var(--radius-xl);
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-5);
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .action-bar-left {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    /* Loading */
    .kanban-loading {
        display: flex;
        gap: var(--space-4);
    }

    .kanban-skeleton-lane {
        flex: 0 0 300px;
        height: 400px;
        background: var(--gray-100);
        border-radius: var(--radius-lg);
        animation: kanbanPulse 1.4s ease-in-out infinite;
    }

    @@keyframes kanbanPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    /* Empty state */
    .kanban-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 60vh;
        gap: var(--space-4);
    }

    .kanban-empty-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 120px;
        height: 120px;
        background: var(--primary-50);
        border-radius: var(--radius-full);
        color: var(--primary);
    }

    .kanban-empty-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .kanban-empty-desc {
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 0;
        max-width: 420px;
    }

    @@media (max-width: 640px) {
        .kanban-lane {
            flex-basis: 85vw;
            max-width: 85vw;
        }
    }
</style>

@code {
    private TodoFilterCriteria _filterCriteria = new();
    private string _selectedPresetName = FilterPreset.KanbanName;
    private bool _isLoading = true;
    private int _filteredCount;

    private TodoItem _currentTodo = new();
    private bool _isEditing;
    private bool _showTodoModal;

    private TodoItem? _draggedTodo;
    private Guid? _dragOverStatusId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // The acting user's effective permissions in the selected project (gates dragging/adding), plus a
    // per-project map for the project tabs. Anonymous/local users always have full control.
    private ProjectPermission _perms = ProjectPermission.All;
    private Dictionary<Guid, ProjectPermission> _projectPerms = new();

    protected override void OnInitialized()
    {
        TodoService.OnTodosChanged += StateHasChanged;
        ProjectService.OnProjectsChanged += StateHasChanged;
        StatusService.OnStatusesChanged += StateHasChanged;
        Track(() => TodoService.OnTodosChanged -= StateHasChanged);
        Track(() => ProjectService.OnProjectsChanged -= StateHasChanged);
        Track(() => StatusService.OnStatusesChanged -= StateHasChanged);
    }

    protected override async Task OnFirstRenderAsync()
    {
        await Task.WhenAll(
            ProjectService.InitializeAsync(),
            TagService.InitializeAsync(),
            StatusService.InitializeAsync(),
            PriorityService.InitializeAsync(),
            TodoService.InitializeAsync(),
            PresetService.InitializeAsync()
        );

        var kanban = PresetService.GetByName(FilterPreset.KanbanName);
        if (kanban is not null)
            _filterCriteria.ApplyPreset(kanban);
        _selectedPresetName = FilterPreset.KanbanName;

        await RefreshPermissionsAsync();
        _isLoading = false;
    }

    // Recompute the acting user's effective permissions for every project (and the selected one).
    // For anonymous/local users there is a single user with full control.
    private async Task RefreshPermissionsAsync()
    {
        _projectPerms = new Dictionary<Guid, ProjectPermission>();

        Guid userId = Guid.Empty;
        var authenticated = false;
        if (AuthState is not null)
        {
            var state = await AuthState;
            authenticated = state.User.Identity?.IsAuthenticated == true;
            var sub = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            Guid.TryParse(sub, out userId);
        }

        if (!authenticated || userId == Guid.Empty)
        {
            _perms = ProjectPermission.All;
            return;
        }

        foreach (var p in ProjectService.Projects)
            _projectPerms[p.Id] = await Access.GetEffectivePermissionsAsync(userId, p.Id);

        var selId = ProjectService.SelectedProject?.Id;
        _perms = selId.HasValue && _projectPerms.TryGetValue(selId.Value, out var pp)
            ? pp
            : ProjectPermission.All;
    }

    private int GetProjectTodoCount()
    {
        var projectId = ProjectService.SelectedProject?.Id;
        return projectId.HasValue
            ? TodoService.Todos.Count(t => t.ParentId is null && t.ProjectId == projectId.Value)
            : TodoService.Todos.Count(t => t.ParentId is null);
    }

    private void HandleProjectSelected(Project project)
    {
        ProjectService.SelectProject(project);
        _perms = _projectPerms.TryGetValue(project.Id, out var pp) ? pp : ProjectPermission.All;
    }

    private async Task HandleSelectedPresetChanged(string? name)
    {
        _selectedPresetName = name ?? FilterPreset.KanbanName;
        await PresetService.SetRememberedPresetNameAsync(name);
    }

    private void HandleDragStart(TodoItem todo) => _draggedTodo = todo;

    private void OnLaneDragLeave(Guid statusId)
    {
        if (_dragOverStatusId == statusId)
            _dragOverStatusId = null;
    }

    private async Task HandleDrop(Guid statusId)
    {
        _dragOverStatusId = null;
        var todo = _draggedTodo;
        _draggedTodo = null;
        if (todo is null || todo.StatusId == statusId) return;
        if (!_perms.HasFlag(ProjectPermission.TodosModify)) return;
        await TodoService.UpdateStatusAsync(todo, statusId);
    }

    private void ShowTodoModal()
    {
        _currentTodo = new TodoItem();
        if (ProjectService.SelectedProject != null)
            _currentTodo.ProjectId = ProjectService.SelectedProject.Id;
        _isEditing = false;
        _showTodoModal = true;
    }

    private void HandleEdit(TodoItem todo)
    {
        _currentTodo = todo;
        _isEditing = true;
        _showTodoModal = true;
    }

    private void HideTodoModal()
    {
        _showTodoModal = false;
        _isEditing = false;
    }

    private async Task HandleFormSubmit(TodoItem todo)
    {
        if (todo.ProjectId == Guid.Empty && ProjectService.SelectedProject != null)
            todo.ProjectId = ProjectService.SelectedProject.Id;
        await TodoService.SaveTodoAsync(todo);
        HideTodoModal();
    }
}
